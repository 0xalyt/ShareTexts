# Production build environment — committed so every Vercel build (and any
# other host) points at OUR signaling worker without manual dashboard setup.
# The Cloudflare transport speaks WebSocket + Durable Objects: rooms, codes,
# links, presence/nearby, stats.
#
# This MUST be the canonical worker in src/lib/socket.ts (SIGNALING_WORKER).
# It used to name a retired host: every production page load opened a dead
# connection first, logged a warning and then fell back to the canonical one,
# which split a room across two Durable Object namespaces mid-handshake.
VITE_SIGNALING_URL=https://sharetext-signaling.alighttt.workers.dev
