{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sharetext-phi.vercel.app"
        }
      ],
      "destination": "https://sharetexts.online/$1",
      "permanent": true
    },
    {
      "source": "/guides/",
      "destination": "/guides",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api-not-found.json"
    },
    {
      "source": "/lookup",
      "destination": "/api-not-found.json"
    },
    {
      "source": "/resolve-short",
      "destination": "/api-not-found.json"
    },
    {
      "source": "/health",
      "destination": "/api-not-found.json"
    },
    {
      "source": "/stats",
      "destination": "/api-not-found.json"
    },
    {
      "source": "/metrics",
      "destination": "/api-not-found.json"
    },
    {
      "source": "/about",
      "destination": "/guides/about.html"
    },
    {
      "source": "/docs",
      "destination": "/seo/docs.html"
    },
    {
      "source": "/privacy",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/seo/terms.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/s/:code",
      "destination": "/index.html"
    },
    {
      "source": "/space/:uuid",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-eLR/EGDHTdMyYyISNU9CsJ/GyIbpnfdXsDluEA+9YdQ=' 'sha256-eMqzSGqQg0AZ0CZe4WBvhwrETkN4EOBLE+OAo76w5cw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' blob: https: wss: ws:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og|brand|demo|emoji-apple|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|favicon-[0-9]+\\.png|icon-[0-9]+\\.png|icon-maskable-[0-9]+\\.png|apple-touch-icon\\.png|manifest\\.json|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
